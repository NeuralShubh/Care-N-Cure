# Care N Cure Backend Environment Variables
# Copy this file to .env locally or set these variables in the Render Dashboard

PORT=5000

# Supabase Project Credentials (Find these in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Vercel Frontend URL (Used for CORS restrictions in production)
# Example: https://care-n-cure.vercel.app
FRONTEND_URL=*
